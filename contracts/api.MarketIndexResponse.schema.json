      "type": "array"
    },
    "spec_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spec Version"
    }
  },
  "required": [
    "base_week",
    "data_window",
    "points"
  ],
  "title": "MarketIndexResponse",
  "type": "object"
