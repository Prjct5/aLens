{
  "additionalProperties": false,
  "description": "staging.image_fetch: images in quarantine.",
  "properties": {
    "fetched_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fetched At"
    },
    "height": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Height"
    },
    "image_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Image Id",
      "type": "string"
    },
    "listing_key": {
      "title": "Listing Key",
      "type": "string"
    },
    "phash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phash"
    },
    "position": {
      "minimum": 0,
      "title": "Position",
      "type": "integer"
    },
    "quarantine_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quarantine Key"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "status": {
      "enum": [
        "fetched",
        "failed",
        "promoted",
        "open_source_commons",
        "synthetic_placeholder"
      ],
      "title": "Status",
      "type": "string"
    },
    "width": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Width"
    }
  },
  "required": [
    "listing_key",
    "position",
    "image_id",
    "status"
  ],
  "title": "ImageFetch",
  "type": "object"
}
