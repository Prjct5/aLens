FROM python:3.15-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DDL_DIR=/app/sql/ddl
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install ".[pipelines,scraping,linkage,warehouse,analytics]"
COPY sql ./sql
RUN useradd --create-home app
USER app
CMD ["python", "-m", "autolens.pipelines.serve"]
